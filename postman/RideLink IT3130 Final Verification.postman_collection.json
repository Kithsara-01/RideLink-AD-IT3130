  "item": [
    {
      "name": "00 - Authentication and Accounts",
      "item": [
        {
          "name": "01 - Register Fresh RIDER",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get(\"runSuffix\")) {\n  const suffix = Date.now().toString().slice(-8);\n  pm.environment.set(\"runSuffix\", suffix);\n  pm.environment.set(\"riderEmail\", `rider.${suffix}@example.com`);\n  pm.environment.set(\"driverEmail\", `driver.${suffix}@example.com`);\n  pm.environment.set(\"secondDriverEmail\", `driver2.${suffix}@example.com`);\n  pm.environment.set(\"driverLicenseNumber\", `DL-${suffix}`);\n  pm.environment.set(\"secondDriverLicenseNumber\", `D2-${suffix}`);\n  pm.environment.set(\"driverPlate\", `WP-${suffix}`);\n  pm.environment.set(\"secondDriverPlate\", `CP-${suffix}`);\n}\nconst makePassword = () => `Rl!${pm.variables.replaceIn(\"{{$randomUUID}}\").replace(/-/g, \"\").slice(0,12)}`;\nif (!pm.environment.get(\"riderPassword\")) pm.environment.set(\"riderPassword\", makePassword());\nif (!pm.environment.get(\"driverPassword\")) pm.environment.set(\"driverPassword\", makePassword());\nif (!pm.environment.get(\"secondDriverPassword\")) pm.environment.set(\"secondDriverPassword\", makePassword());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));\nconst j=pm.response.json(); pm.expect(j.role).to.eql(\"RIDER\"); pm.expect(j.active).to.eql(true); pm.environment.set(\"riderAccountId\",j.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Rider 1\",\n  \"email\": \"{{riderEmail}}\",\n  \"password\": \"{{riderPassword}}\",\n  \"role\": \"RIDER\",\n  \"telephoneNumber\": \"+94770001001\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{accountBaseUrl}}/api/accounts/register",
              "host": [
                "{{accountBaseUrl}}"
              ],
              "path": [
                "api",
                "accounts",
                "register"
              ]
            },
            "description": "Purpose: Create a fresh RIDER account for this verification run.\nRequired role/token: None. Public endpoint.\nRequired current state: Services running; unique generated email.\nExpected HTTP status: 201\nImportant response fields: id, email, role=RIDER, active=true\nDatabase state change: Creates account.\nREPORT EVIDENCE: Not necessary"
          },
          "response": []
        },
